# Copy to .env for local use (.env is gitignored). In Railway set these in the service's Variables tab.
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgres://hackathon:hackathon@localhost:5432/hackathon?sslmode=disable
# Railway sets PORT itself; locally it defaults to 8080.
# PORT=8080
# Needed only by the M0 harness / AI seats:
# OPENROUTER_API_KEY=
# Game (SPEC §10). Defaults: 2 humans, 3 AI, 2 rounds, 60/45/90/30/45 s.
# HUMANS_PER_GAME=2
# AI_PER_GAME=3
# ROUNDS=2
# T_INTRO=60
# T_ASK=45
# T_ANSWER=90
# T_REVEAL=30
# T_VOTE=45
# Dev only: seat a bot_human with a lone player after N seconds (0 = off).
# DEV_BOT_HUMAN_AFTER_SEC=0
# Extra allowed WebSocket origins (host[:port], comma-separated). `make dev` sets localhost:3000.
# WS_ORIGINS=
