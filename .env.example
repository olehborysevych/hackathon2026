# Copy to .env for local use (.env is gitignored). In Railway set these in the service's Variables tab.
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgres://hackathon:hackathon@localhost:5432/hackathon?sslmode=disable
# Railway sets PORT itself; locally it defaults to 8080.
# PORT=8080
# AI seats. Without OPENROUTER_API_KEY (or with AI_MODE=stub) AI seats use canned stub lines.
# Turn on zero data retention in the OpenRouter privacy settings first: player messages are in prompts.
# OPENROUTER_API_KEY=
# AI_SEAT_MODELS=google/gemma-4-31b-it            # comma-separated, one per AI seat (round-robin); no Llama
# PROMPT_VERSION=v3
# CRITIC_MODEL=                                   # empty = no critic (recommended for v2)
# GAME_CONTEXT=Hackathon at <venue>, <city>       # seats know the venue; current date/time is added
# GAME_TZ=Europe/Berlin                           # venue time zone for the seats' clock
# AI_MODE=stub                                    # force the stub even with a key
# Game (SPEC §10). Defaults: 2 humans, 3 AI, 1 round, 60/45/90/30/45 s.
# HUMANS_PER_GAME=2
# AI_PER_GAME=3
# ROUNDS=1
# T_INTRO=60
# T_ASK=45
# T_ANSWER=90
# T_REVEAL=30
# T_VOTE=45
# Dev only: seat a bot_human with a lone player after N seconds (0 = off).
# DEV_BOT_HUMAN_AFTER_SEC=0
# Extra allowed WebSocket origins (host[:port], comma-separated). `make dev` sets localhost:3000.
# WS_ORIGINS=
